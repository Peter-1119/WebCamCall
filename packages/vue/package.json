{
  "name": "@cclemon/scanner-vue",
  "version": "0.1.2",
  "description": "Vue 3 composable for @cclemon/scanner-core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peter-1119/WebCamCall.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@cclemon/scanner-core": "*"
  },
  "devDependencies": {
    "vue": "^3.5.42",
    "@cclemon/scanner-core": "workspace:*"
  }
}
