{
  "name": "@scanner/ui",
  "version": "0.1.0",
  "description": "Optional default overlay components for @scanner/vue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peter-1119/WebCamCall.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@scanner/core": "*",
    "@scanner/vue": "*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.0",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.1.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "@scanner/core": "workspace:*",
    "@scanner/vue": "workspace:*"
  }
}
