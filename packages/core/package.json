{
  "name": "@scanner/core",
  "version": "0.1.0",
  "description": "Headless, framework-agnostic barcode / QR scanner core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peter-1119/WebCamCall.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "zxing-wasm": "3.1.4"
  }
}
