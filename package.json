{
  "name": "scanner-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "dev": "pnpm -r --parallel --filter @scanner/core --filter playground run dev",
    "clean": "pnpm -r exec rm -rf dist",
    "dev:core": "pnpm --filter @scanner/core dev",
    "release:pack": "bash scripts/release-pack.sh"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "happy-dom": "^20.14.5",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
